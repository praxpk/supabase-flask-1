# --- Supabase Variables ---
# The public URL of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co

# The public anonymous key (safe for client-side, but also used for basic backend queries)
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# The secret service role key (NEVER expose this to the frontend)
SUPABASE_SECRET_KEY=your-service-role-key-here

# --- Flask Variables ---
# Used for session management, CSRF protection, and secure cookies
FLASK_SECRET_KEY=your-super-secret-flask-key

# Set to 'development' or 'production'
FLASK_ENV=development

# --- Optional: Direct Database Connection ---
# If you are using SQLAlchemy directly instead of the Supabase Python SDK
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres